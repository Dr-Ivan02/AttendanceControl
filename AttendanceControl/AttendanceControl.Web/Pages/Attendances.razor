@page "/attendances"
@inject AttendanceControl.Web.Services.AttendanceApiService AttendanceService
@inject AttendanceControl.Web.Services.CourseApiService CourseService

<PageTitle>Asistencias</PageTitle>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
    <p style="color:var(--color-ink-light); margin:0;">Registra y consulta la asistencia por curso completo.</p>
    <button class="btn btn-accent" @onclick="OpenCreateModal" disabled="@(courses is null || courses.Count == 0)">+ Nueva asistencia</button>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (courses is not null && courses.Count == 0)
{
    <div class="alert alert-danger">Debes crear al menos un curso antes de registrar asistencias.</div>
}

@if (attendances is null)
{
    <p>Cargando asistencias...</p>
}
else if (attendances.Count == 0)
{
    <div class="card empty-state">
        <h3>Aún no hay asistencias registradas</h3>
        <p>Registra la primera para empezar a llevar el control.</p>
    </div>
}
else
{
    <div class="card" style="padding:0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Curso</th>
                    <th>Presentes</th>
                    <th>Ausentes</th>
                    <th style="width:230px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in attendances)
                {
                    <tr>
                        <td class="mono">@a.Date.ToString("yyyy-MM-dd")</td>
                        <td>@CourseName(a)</td>
                        <td><span class="stamp stamp-present">@a.PresentCount / @a.TotalStudents</span></td>
                        <td><span class="stamp stamp-absent">@a.AbsentCount</span></td>
                        <td>
                            <button class="btn btn-secondary" style="padding:0.35rem 0.7rem; margin-right:0.4rem;" @onclick="() => OpenDetails(a)">Ver</button>
                            <button class="btn btn-secondary" style="padding:0.35rem 0.7rem; margin-right:0.4rem;" @onclick="() => OpenEditModal(a)">Editar</button>
                            <button class="btn btn-danger" style="padding:0.35rem 0.7rem;" @onclick="() => ConfirmDelete(a)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3>@(editingId is null ? "Nueva asistencia" : "Editar asistencia")</h3>

            @if (formError is not null)
            {
                <div class="alert alert-danger">@formError</div>
            }

            <div class="form-group">
                <label>Fecha</label>
                <input type="date" @bind="formDate" />
            </div>
            <div class="form-group">
                <label>Curso</label>
                <select value="@formCourseId" @onchange="OnCourseChanged" disabled="@(editingId is not null)">
                    <option value="0">Selecciona un curso...</option>
                    @if (courses is not null)
                    {
                        @foreach (var c in courses)
                        {
                            <option value="@c.Id">@c.Code - @c.Name</option>
                        }
                    }
                </select>
            </div>

            @if (loadingStudents)
            {
                <p>Cargando estudiantes del curso...</p>
            }
            else if (formCourseId != 0 && studentRows.Count == 0)
            {
                <div class="alert alert-danger">Este curso no tiene estudiantes activos.</div>
            }
            else if (studentRows.Count > 0)
            {
                <div class="card" style="padding:0; margin-top:1rem;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th style="width:140px;">Presente</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in studentRows)
                            {
                                <tr>
                                    <td>@row.Code - @row.Name</td>
                                    <td>
                                        <input type="checkbox" style="width:auto;" @bind="row.IsPresent" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1.25rem;">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveAttendance" disabled="@(isSaving || studentRows.Count == 0)">
                    @(isSaving ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@if (detailsAttendance is not null)
{
    <div class="modal-backdrop" @onclick="CloseDetails">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3>Detalle de asistencia</h3>
            <p style="color:var(--color-ink-light);">
                @detailsAttendance.Date.ToString("yyyy-MM-dd") - @CourseName(detailsAttendance)
            </p>
            <div class="card" style="padding:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in detailsAttendance.Details.OrderBy(d => d.StudentName))
                        {
                            <tr>
                                <td>@detail.StudentCode - @detail.StudentName</td>
                                <td>
                                    @if (detail.IsPresent)
                                    {
                                        <span class="stamp stamp-present">Presente</span>
                                    }
                                    else
                                    {
                                        <span class="stamp stamp-absent">Ausente</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1.25rem;">
                <button class="btn btn-secondary" @onclick="CloseDetails">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm && attendanceToDelete is not null)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3>¿Eliminar este registro?</h3>
            <p style="color:var(--color-ink-light);">
                Vas a eliminar la asistencia del @attendanceToDelete.Date.ToString("yyyy-MM-dd") para @CourseName(attendanceToDelete). Esta acción no se puede deshacer.
            </p>
            <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1.25rem;">
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                <button class="btn btn-danger" @onclick="DoDelete">Sí, eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AttendanceControl.Web.Models.AttendanceDTO>? attendances;
    private List<AttendanceControl.Web.Models.CourseDTO>? courses;
    private string? errorMessage;

    private bool showModal = false;
    private int? editingId = null;
    private DateTime formDate = DateTime.Today;
    private int formCourseId = 0;
    private string? formError;
    private bool isSaving = false;
    private bool loadingStudents = false;
    private List<StudentAttendanceRow> studentRows = new();

    private AttendanceControl.Web.Models.AttendanceDTO? detailsAttendance;
    private bool showDeleteConfirm = false;
    private AttendanceControl.Web.Models.AttendanceDTO? attendanceToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            errorMessage = null;
            courses = await CourseService.GetAllAsync();
            attendances = await AttendanceService.GetAllAsync();
        }
        catch
        {
            errorMessage = "No se pudo conectar con el servidor. Verifica que la API esté corriendo.";
            courses = new();
            attendances = new();
        }
    }

    private async Task ReloadAttendances()
    {
        attendances = await AttendanceService.GetAllAsync();
    }

    private string CourseName(AttendanceControl.Web.Models.AttendanceDTO attendance)
    {
        if (!string.IsNullOrWhiteSpace(attendance.CourseName))
            return attendance.CourseName;

        var course = courses?.FirstOrDefault(c => c.Id == attendance.CourseId);
        return course is null ? "-" : $"{course.Code} - {course.Name}";
    }

    private void OpenCreateModal()
    {
        editingId = null;
        formDate = DateTime.Today;
        formCourseId = 0;
        formError = null;
        studentRows = new();
        showModal = true;
    }

    private void OpenEditModal(AttendanceControl.Web.Models.AttendanceDTO attendance)
    {
        editingId = attendance.Id;
        formDate = attendance.Date;
        formCourseId = attendance.CourseId;
        formError = null;
        studentRows = attendance.Details
            .OrderBy(d => d.StudentName)
            .Select(d => new StudentAttendanceRow
            {
                StudentId = d.StudentId,
                Code = d.StudentCode,
                Name = d.StudentName,
                IsPresent = d.IsPresent
            })
            .ToList();
        showModal = true;
    }

    private async Task OnCourseChanged(ChangeEventArgs args)
    {
        formError = null;
        studentRows = new();

        if (!int.TryParse(args.Value?.ToString(), out formCourseId) || formCourseId == 0)
            return;

        loadingStudents = true;
        try
        {
            var students = await CourseService.GetStudentsAsync(formCourseId);
            studentRows = students
                .OrderBy(s => s.Name)
                .Select(s => new StudentAttendanceRow
                {
                    StudentId = s.Id,
                    Code = s.Code,
                    Name = s.Name,
                    IsPresent = true
                })
                .ToList();
        }
        catch
        {
            formError = "No se pudieron cargar los estudiantes del curso.";
        }
        finally
        {
            loadingStudents = false;
        }
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveAttendance()
    {
        if (formCourseId == 0)
        {
            formError = "Debes seleccionar un curso.";
            return;
        }

        if (studentRows.Count == 0)
        {
            formError = "El curso seleccionado no tiene estudiantes para registrar.";
            return;
        }

        isSaving = true;
        formError = null;

        var dto = new AttendanceControl.Web.Models.CreateAttendanceDTO
        {
            Date = formDate.Date,
            CourseId = formCourseId,
            Details = studentRows
                .Select(row => new AttendanceControl.Web.Models.CreateAttendanceDetailDTO
                {
                    StudentId = row.StudentId,
                    IsPresent = row.IsPresent
                })
                .ToList()
        };

        bool success = editingId is null
            ? await AttendanceService.CreateAsync(dto)
            : await AttendanceService.UpdateAsync(editingId.Value, dto);

        isSaving = false;

        if (success)
        {
            showModal = false;
            await ReloadAttendances();
        }
        else
        {
            formError = "No se pudo guardar la asistencia. Revisa si ya existe una asistencia para ese curso y fecha.";
        }
    }

    private void OpenDetails(AttendanceControl.Web.Models.AttendanceDTO attendance)
    {
        detailsAttendance = attendance;
    }

    private void CloseDetails()
    {
        detailsAttendance = null;
    }

    private void ConfirmDelete(AttendanceControl.Web.Models.AttendanceDTO attendance)
    {
        attendanceToDelete = attendance;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        attendanceToDelete = null;
    }

    private async Task DoDelete()
    {
        if (attendanceToDelete is null) return;

        await AttendanceService.DeleteAsync(attendanceToDelete.Id);
        showDeleteConfirm = false;
        attendanceToDelete = null;
        await ReloadAttendances();
    }

    private class StudentAttendanceRow
    {
        public int StudentId { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public bool IsPresent { get; set; }
    }
}
