@page "/attendances"
@inject AttendanceControl.Web.Services.AttendanceApiService AttendanceService
@inject AttendanceControl.Web.Services.StudentApiService StudentService
@inject AttendanceControl.Web.Services.CourseApiService CourseService

<PageTitle>Asistencias</PageTitle>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
    <p style="color:var(--color-ink-light); margin:0;">Registra y consulta la asistencia por estudiante.</p>
    <button class="btn btn-accent" @onclick="OpenCreateModal" disabled="@(students is null || students.Count == 0)">+ Nueva asistencia</button>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (students is not null && students.Count == 0)
{
    <div class="alert alert-danger">Debes crear al menos un estudiante antes de registrar asistencias.</div>
}

@if (attendances is null)
{
    <p>Cargando asistencias...</p>
}
else if (attendances.Count == 0)
{
    <div class="card empty-state">
        <h3>Aún no hay asistencias registradas</h3>
        <p>Registra la primera para empezar a llevar el control.</p>
    </div>
}
else
{
    <div class="card" style="padding:0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Estudiante</th>
                    <th>Curso</th>
                    <th>Estado</th>
                    <th style="width:160px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in attendances)
                {
                    <tr>
                        <td class="mono">@a.Date.ToString("yyyy-MM-dd")</td>
                        <td>@StudentName(a.StudentId)</td>
                        <td>@CourseName(a.CourseId)</td>
                        <td>
                            @if (a.IsPresent)
                            {
                                <span class="stamp stamp-present">Presente</span>
                            }
                            else
                            {
                                <span class="stamp stamp-absent">Ausente</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-secondary" style="padding:0.35rem 0.7rem; margin-right:0.4rem;" @onclick="() => OpenEditModal(a)">Editar</button>
                            <button class="btn btn-danger" style="padding:0.35rem 0.7rem;" @onclick="() => ConfirmDelete(a)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3>@(editingId is null ? "Nueva asistencia" : "Editar asistencia")</h3>

            @if (formError is not null)
            {
                <div class="alert alert-danger">@formError</div>
            }

            <div class="form-group">
                <label>Fecha</label>
                <input type="date" @bind="formDate" />
            </div>
            <div class="form-group">
                <label>Estudiante</label>
                <select @bind="formStudentId">
                    <option value="0">Selecciona un estudiante...</option>
                    @if (students is not null)
                    {
                        @foreach (var s in students)
                        {
                            <option value="@s.Id">@s.Code - @s.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Curso</label>
                <select @bind="formCourseId">
                    <option value="0">Selecciona un curso...</option>
                    @if (courses is not null)
                    {
                        @foreach (var c in courses)
                        {
                            <option value="@c.Id">@c.Code - @c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label style="display:flex; align-items:center; gap:0.5rem; font-weight:500;">
                    <input type="checkbox" style="width:auto;" @bind="formIsPresent" />
                    Marcar como presente
                </label>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1.25rem;">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveAttendance" disabled="@isSaving">
                    @(isSaving ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm && attendanceToDelete is not null)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3>¿Eliminar este registro?</h3>
            <p style="color:var(--color-ink-light);">
                Vas a eliminar la asistencia del @attendanceToDelete.Date.ToString("yyyy-MM-dd"). Esta acción no se puede deshacer.
            </p>
            <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1.25rem;">
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                <button class="btn btn-danger" @onclick="DoDelete">Sí, eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AttendanceControl.Web.Models.AttendanceDTO>? attendances;
    private List<AttendanceControl.Web.Models.StudentDTO>? students;
    private List<AttendanceControl.Web.Models.CourseDTO>? courses;
    private string? errorMessage;

    private bool showModal = false;
    private int? editingId = null;
    private DateTime formDate = DateTime.Today;
    private int formStudentId = 0;
    private int formCourseId = 0;
    private bool formIsPresent = true;
    private string? formError;
    private bool isSaving = false;

    private bool showDeleteConfirm = false;
    private AttendanceControl.Web.Models.AttendanceDTO? attendanceToDelete;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            errorMessage = null;
            students = await StudentService.GetAllAsync();
            courses = await CourseService.GetAllAsync();
            attendances = await AttendanceService.GetAllAsync();
        }
        catch
        {
            errorMessage = "No se pudo conectar con el servidor. Verifica que la API esté corriendo.";
            students = new();
            courses = new();
            attendances = new();
        }
    }

    private async Task ReloadAttendances()
    {
        attendances = await AttendanceService.GetAllAsync();
    }

    private string StudentName(int id)
    {
        var s = students?.FirstOrDefault(x => x.Id == id);
        return s is null ? "—" : $"{s.Code} - {s.Name}";
    }

    private string CourseName(int id)
    {
        var c = courses?.FirstOrDefault(x => x.Id == id);
        return c is null ? "—" : $"{c.Code} - {c.Name}";
    }

    private void OpenCreateModal()
    {
        editingId = null;
        formDate = DateTime.Today;
        formStudentId = 0;
        formCourseId = 0;
        formIsPresent = true;
        formError = null;
        showModal = true;
    }

    private void OpenEditModal(AttendanceControl.Web.Models.AttendanceDTO a)
    {
        editingId = a.Id;
        formDate = a.Date;
        formStudentId = a.StudentId;
        formCourseId = a.CourseId;
        formIsPresent = a.IsPresent;
        formError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveAttendance()
    {
        if (formStudentId == 0 || formCourseId == 0)
        {
            formError = "Debes seleccionar un estudiante y un curso.";
            return;
        }

        isSaving = true;
        formError = null;

        var dto = new AttendanceControl.Web.Models.CreateAttendanceDTO
        {
            Date = formDate,
            IsPresent = formIsPresent,
            StudentId = formStudentId,
            CourseId = formCourseId
        };

        bool success = editingId is null
            ? await AttendanceService.CreateAsync(dto)
            : await AttendanceService.UpdateAsync(editingId.Value, dto);

        isSaving = false;

        if (success)
        {
            showModal = false;
            await ReloadAttendances();
        }
        else
        {
            formError = "No se pudo guardar la asistencia. Verifica los datos e intenta de nuevo.";
        }
    }

    private void ConfirmDelete(AttendanceControl.Web.Models.AttendanceDTO a)
    {
        attendanceToDelete = a;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        attendanceToDelete = null;
    }

    private async Task DoDelete()
    {
        if (attendanceToDelete is null) return;

        await AttendanceService.DeleteAsync(attendanceToDelete.Id);
        showDeleteConfirm = false;
        attendanceToDelete = null;
        await ReloadAttendances();
    }
}