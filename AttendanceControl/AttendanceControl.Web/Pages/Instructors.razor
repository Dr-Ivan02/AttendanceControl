@page "/instructors"
@inject AttendanceControl.Web.Services.InstructorApiService InstructorService

<PageTitle>Instructores</PageTitle>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
    <p style="color:var(--color-ink-light); margin:0;">Gestiona los instructores del instituto.</p>
    <button class="btn btn-accent" @onclick="OpenCreateModal">+ Nuevo instructor</button>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (instructors is null)
{
    <p>Cargando instructores...</p>
}
else if (instructors.Count == 0)
{
    <div class="card empty-state">
        <h3>Aún no hay instructores</h3>
        <p>Agrega el primero para poder asignarlo a un curso.</p>
        <button class="btn btn-primary" @onclick="OpenCreateModal">+ Nuevo instructor</button>
    </div>
}
else
{
    <div class="search-box">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" placeholder="Buscar por código o nombre..." @bind="searchTerm" @bind:event="oninput" />
    </div>

    @if (FilteredInstructors.Count == 0)
    {
        <div class="card empty-state">
            <p>No se encontraron instructores que coincidan con "@searchTerm".</p>
        </div>
    }
    else
    {
        <div class="card" style="padding:0;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th style="width:160px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instructor in FilteredInstructors)
                    {
                        <tr>
                            <td class="mono">@instructor.Code</td>
                            <td>@instructor.Name</td>
                            <td>
                                <button class="btn btn-secondary" style="padding:0.35rem 0.7rem; margin-right:0.4rem;" @onclick="() => OpenEditModal(instructor)">Editar</button>
                                <button class="btn btn-danger" style="padding:0.35rem 0.7rem;" @onclick="() => ConfirmDelete(instructor)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3>@(editingId is null ? "Nuevo instructor" : "Editar instructor")</h3>

            @if (formError is not null)
            {
                <div class="alert alert-danger">@formError</div>
            }

            <div class="form-group">
                <label>Código</label>
                <input @bind="formCode" placeholder="Ej. PROF01" />
            </div>
            <div class="form-group">
                <label>Nombre</label>
                <input @bind="formName" placeholder="Ej. María Gómez" />
            </div>

            <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1.25rem;">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveInstructor" disabled="@isSaving">
                    @(isSaving ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm && instructorToDelete is not null)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3>¿Eliminar este instructor?</h3>
            <p style="color:var(--color-ink-light);">
                Vas a eliminar <strong>@instructorToDelete.Name</strong> (@instructorToDelete.Code). Esta acción no se puede deshacer.
            </p>
            <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1.25rem;">
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                <button class="btn btn-danger" @onclick="DoDelete">Sí, eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AttendanceControl.Web.Models.InstructorDTO>? instructors;
    private string? errorMessage;
    private string searchTerm = "";

    private List<AttendanceControl.Web.Models.InstructorDTO> FilteredInstructors =>
        instructors is null
            ? new()
            : string.IsNullOrWhiteSpace(searchTerm)
                ? instructors
                : instructors.Where(i =>
                    i.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    i.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                  .ToList();

    private bool showModal = false;
    private int? editingId = null;
    private string formCode = "";
    private string formName = "";
    private string? formError;
    private bool isSaving = false;

    private bool showDeleteConfirm = false;
    private AttendanceControl.Web.Models.InstructorDTO? instructorToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstructors();
    }

    private async Task LoadInstructors()
    {
        try
        {
            errorMessage = null;
            instructors = await InstructorService.GetAllAsync();
        }
        catch
        {
            errorMessage = "No se pudo conectar con el servidor. Verifica que la API esté corriendo.";
            instructors = new();
        }
    }

    private void OpenCreateModal()
    {
        editingId = null;
        formCode = "";
        formName = "";
        formError = null;
        showModal = true;
    }

    private void OpenEditModal(AttendanceControl.Web.Models.InstructorDTO instructor)
    {
        editingId = instructor.Id;
        formCode = instructor.Code;
        formName = instructor.Name;
        formError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveInstructor()
    {
        if (string.IsNullOrWhiteSpace(formName) || string.IsNullOrWhiteSpace(formCode))
        {
            formError = "Código y nombre son obligatorios.";
            return;
        }

        isSaving = true;
        formError = null;

        var dto = new AttendanceControl.Web.Models.CreateInstructorDTO { Code = formCode, Name = formName };
        bool success = editingId is null
            ? await InstructorService.CreateAsync(dto)
            : await InstructorService.UpdateAsync(editingId.Value, dto);

        isSaving = false;

        if (success)
        {
            showModal = false;
            await LoadInstructors();
        }
        else
        {
            formError = "No se pudo guardar el instructor. Verifica los datos e intenta de nuevo.";
        }
    }

    private void ConfirmDelete(AttendanceControl.Web.Models.InstructorDTO instructor)
    {
        instructorToDelete = instructor;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        instructorToDelete = null;
    }

    private async Task DoDelete()
    {
        if (instructorToDelete is null) return;

        await InstructorService.DeleteAsync(instructorToDelete.Id);
        showDeleteConfirm = false;
        instructorToDelete = null;
        await LoadInstructors();
    }
}